# Local development only. Copy to .env and change values as needed.
ESPIAL_ENV=development
ESPIAL_LISTEN_ADDRESS=127.0.0.1:8080
ESPIAL_PUBLIC_URL=http://localhost:5173
ESPIAL_AUTH_MODE=local
ESPIAL_AUTH_SESSION_IDLE=30m
ESPIAL_AUTH_SESSION_ABSOLUTE=12h
ESPIAL_AUTH_FAILURE_LIMIT=5
ESPIAL_AUTH_LOCKOUT_DURATION=15m
ESPIAL_AUTH_LOGIN_RATE_LIMIT=10
ESPIAL_AUTH_LOGIN_RATE_WINDOW=1m
ESPIAL_DATABASE_DSN_FILE=/run/secrets/database_dsn
ESPIAL_DATABASE_DSN_SECRET_FILE=./database_dsn.example
ESPIAL_DATABASE_MIGRATE_ON_START=true
ESPIAL_DATABASE_MAX_OPEN_CONNECTIONS=20
# Absolute path inside the Core runtime; the local image installs this binary.
ESPIAL_SAMPLE_ADAPTER_EXECUTABLE=/espial-sample-adapter
ESPIAL_WEBCHECK_EXECUTABLE=/espial-webcheck-adapter
ESPIAL_WEBCHECK_MAX_REDIRECTS=0
ESPIAL_WEBCHECK_RESPONSE_BODY_LIMIT_BYTES=262144
ESPIAL_WEBCHECK_RESPONSE_HEADER_LIMIT_BYTES=32768
ESPIAL_WEBCHECK_RESOLVE_TIMEOUT=2s
# Fail closed by default. Every hostname and every resolved address must match.
ESPIAL_WEBCHECK_APPROVED_HOSTS=
ESPIAL_WEBCHECK_APPROVED_CIDRS=
ESPIAL_WEBCHECK_ALLOWED_PORTS=80,443
ESPIAL_WEBCHECK_SECRET_DIRECTORY=/run/secrets
ESPIAL_ADAPTER_GLOBAL_CONCURRENCY=4
ESPIAL_ADAPTER_RECONCILE_INTERVAL=10s
ESPIAL_FRESHNESS_INTERVAL=1s
ESPIAL_FRESHNESS_BATCH_SIZE=100
ESPIAL_EVENT_REPLAY_SIZE=1024
ESPIAL_SSE_HEARTBEAT=15s
ESPIAL_SSE_MAX_CLIENTS=100
ESPIAL_NOTIFICATION_WORKER_CONCURRENCY=2
ESPIAL_NOTIFICATION_MAX_ATTEMPTS=6
ESPIAL_NOTIFICATION_REQUEST_TIMEOUT=10s
ESPIAL_NOTIFICATION_RESOLVE_TIMEOUT=2s
ESPIAL_NOTIFICATION_RESPONSE_BODY_LIMIT_BYTES=4096
# Fail closed by default. Add exact Mattermost host/CIDR pairs for local testing.
ESPIAL_NOTIFICATION_APPROVED_HOSTS=
ESPIAL_NOTIFICATION_APPROVED_CIDRS=
ESPIAL_NOTIFICATION_ALLOWED_PORTS=443
ESPIAL_NOTIFICATION_SECRET_DIRECTORY=/run/secrets
# Local destination secret reference: mattermost_webhook
ESPIAL_MATTERMOST_WEBHOOK_SECRET_FILE=./mattermost_webhook.example

# The local Compose stack reads this non-secret development value.
POSTGRES_DB=espial
POSTGRES_USER=espial
POSTGRES_PASSWORD=espial-local-only
POSTGRES_PORT=55432
ESPIAL_CORE_PORT=18080
ESPIAL_WEB_PORT=5173
