# Local development only. Copy to .env and change values as needed.
ESPIAL_ENV=development
ESPIAL_LISTEN_ADDRESS=127.0.0.1:8080
ESPIAL_PUBLIC_URL=http://localhost:5173
ESPIAL_AUTH_MODE=local
ESPIAL_AUTH_SESSION_IDLE=30m
ESPIAL_AUTH_SESSION_ABSOLUTE=12h
ESPIAL_AUTH_FAILURE_LIMIT=5
ESPIAL_AUTH_LOCKOUT_DURATION=15m
ESPIAL_AUTH_LOGIN_RATE_LIMIT=10
ESPIAL_AUTH_LOGIN_RATE_WINDOW=1m
ESPIAL_DATABASE_DSN_FILE=/run/secrets/database_dsn
# Absolute path inside the Core runtime; the local image installs this binary.
ESPIAL_SAMPLE_ADAPTER_EXECUTABLE=/espial-sample-adapter

# The local Compose stack reads this non-secret development value.
POSTGRES_DB=espial
POSTGRES_USER=espial
POSTGRES_PASSWORD=espial-local-only
POSTGRES_PORT=55432
ESPIAL_CORE_PORT=18080
ESPIAL_WEB_PORT=5173
