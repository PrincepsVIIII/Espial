ESPIAL_PUBLIC_HOST=espial.example.invalid

# Replace tags with registry digests after publishing the release images.
ESPIAL_CORE_IMAGE=ghcr.io/princepsviiii/espial-core:phase-1.0.0
ESPIAL_WEB_IMAGE=ghcr.io/princepsviiii/espial-web:phase-1.0.0

ESPIAL_POSTGRES_OWNER_PASSWORD_FILE=./secrets/postgres_owner_password
ESPIAL_POSTGRES_APP_PASSWORD_FILE=./secrets/postgres_app_password
ESPIAL_DATABASE_OWNER_DSN_FILE=./secrets/database_owner_dsn
ESPIAL_DATABASE_APP_DSN_FILE=./secrets/database_app_dsn

ESPIAL_DATABASE_MAX_OPEN_CONNECTIONS=20
ESPIAL_ADAPTER_GLOBAL_CONCURRENCY=4
ESPIAL_ADAPTER_RECONCILE_INTERVAL=10s
ESPIAL_FRESHNESS_INTERVAL=1s
ESPIAL_FRESHNESS_BATCH_SIZE=100
ESPIAL_EVENT_REPLAY_SIZE=1024
ESPIAL_SSE_HEARTBEAT=15s
ESPIAL_SSE_MAX_CLIENTS=100
