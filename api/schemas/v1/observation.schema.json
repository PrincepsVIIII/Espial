{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espial.ubnetdef.org/schemas/v1/observation.schema.json",
  "title": "Normalized observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "external_resource_id",
    "check_type",
    "state",
    "summary",
    "observed_at",
    "expected_refresh_seconds"
  ],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "external_resource_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "check_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,126}$"},
    "state": {
      "type": "string",
      "enum": ["healthy", "warning", "critical", "unknown", "maintenance", "disabled"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
    "observed_at": {"type": "string", "format": "date-time"},
    "expected_refresh_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "measurements": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {"type": ["number", "integer", "string", "boolean"]}
    },
    "metadata": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    }
  }
}
