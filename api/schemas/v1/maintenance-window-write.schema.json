{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espial.ubnetdef.org/schemas/v1/maintenance-window-write.schema.json",
  "title": "Maintenance window write",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason", "starts_at", "ends_at", "enabled"],
  "properties": {
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "integration_id": { "type": "string", "format": "uuid" },
    "resource_id": { "type": "string", "format": "uuid" },
    "check_type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,126}$" },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at": { "type": "string", "format": "date-time" },
    "enabled": { "type": "boolean" }
  }
}
