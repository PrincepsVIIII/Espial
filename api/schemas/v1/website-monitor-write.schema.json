{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espial.ubnetdef.org/schemas/v1/website-monitor-write.schema.json",
  "title": "Website monitor replacement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "display_name",
    "enabled",
    "url",
    "interval_seconds",
    "timeout_ms",
    "warning_latency_ms",
    "allowed_statuses",
    "content_match",
    "follow_redirects",
    "max_redirects",
    "secret_headers"
  ],
  "properties": {
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "enabled": { "type": "boolean" },
    "url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "interval_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "warning_latency_ms": { "type": "integer", "minimum": 0, "maximum": 59999 },
    "allowed_statuses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 100, "maximum": 599 }
    },
    "content_match": { "type": "string", "maxLength": 4096 },
    "follow_redirects": { "type": "boolean" },
    "max_redirects": { "type": "integer", "minimum": 0, "maximum": 5 },
    "secret_headers": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secret_reference"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "secret_reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        }
      }
    }
  }
}
