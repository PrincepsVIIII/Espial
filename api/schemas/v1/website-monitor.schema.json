{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espial.ubnetdef.org/schemas/v1/website-monitor.schema.json",
  "title": "Redacted website monitor API view",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "enabled",
    "url",
    "interval_seconds",
    "timeout_ms",
    "allowed_statuses",
    "content_match_configured",
    "follow_redirects",
    "max_redirects",
    "secret_header_names",
    "runtime_state",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "enabled": { "type": "boolean" },
    "url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "interval_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000 },
    "warning_latency_ms": { "type": "integer", "minimum": 1, "maximum": 59999 },
    "allowed_statuses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 100, "maximum": 599 }
    },
    "content_match_configured": { "type": "boolean" },
    "follow_redirects": { "type": "boolean" },
    "max_redirects": { "type": "integer", "minimum": 0, "maximum": 5 },
    "secret_header_names": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "runtime_state": {
      "enum": [
        "disabled",
        "not_started",
        "starting",
        "healthy",
        "unhealthy",
        "stopped"
      ]
    },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
