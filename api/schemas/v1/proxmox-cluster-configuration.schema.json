{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espial.ubnetdef.org/schemas/v1/proxmox-cluster-configuration.schema.json",
  "title": "Proxmox cluster configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "display_name", "base_url", "approve_target", "allow_insecure_http",
    "trust_self_signed_certificate", "deployment_id", "token_id", "token_secret_configured",
    "interval_seconds", "expected_refresh_seconds", "request_timeout_seconds",
    "storage_warning_percent", "storage_critical_percent", "swap_warning_percent",
    "swap_critical_percent", "io_wait_warning_percent", "io_wait_critical_percent",
    "expected_running_guests", "updated_at", "version"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "base_url": { "type": "string", "format": "uri", "maxLength": 2048 },
    "approve_target": { "type": "boolean", "const": true },
    "allow_insecure_http": { "type": "boolean" },
    "trust_self_signed_certificate": { "type": "boolean" },
    "deployment_id": { "type": "string" },
    "token_id": { "type": "string" },
    "token_secret_configured": { "type": "boolean" },
    "interval_seconds": { "type": "integer" },
    "expected_refresh_seconds": { "type": "integer" },
    "request_timeout_seconds": { "type": "integer" },
    "storage_warning_percent": { "type": "number" },
    "storage_critical_percent": { "type": "number" },
    "swap_warning_percent": { "type": "number" },
    "swap_critical_percent": { "type": "number" },
    "io_wait_warning_percent": { "type": "number" },
    "io_wait_critical_percent": { "type": "number" },
    "expected_running_guests": { "type": "array", "items": { "type": "string" } },
    "updated_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 }
  }
}
