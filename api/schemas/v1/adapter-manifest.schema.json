{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espial.ubnetdef.org/schemas/v1/adapter-manifest.schema.json",
  "title": "Adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "display_name",
    "adapter_version",
    "protocol_versions",
    "integration_category",
    "capabilities",
    "config_schema"
  ],
  "properties": {
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,126}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
    },
    "integration_category": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "resource_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"}
    },
    "check_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,126}$"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["collect", "events", "notifications", "actions"]}
    },
    "read_only": {"type": "boolean", "default": true},
    "config_schema": {"type": "object"},
    "secret_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    }
  }
}
