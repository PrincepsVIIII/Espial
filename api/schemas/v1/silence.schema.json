{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espial.ubnetdef.org/schemas/v1/silence.schema.json",
  "title": "Notification silence",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "reason", "starts_at", "expires_at", "enabled", "created_by_name", "version", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
    "incident_id": { "type": "string", "format": "uuid" },
    "rule_id": { "type": "string", "format": "uuid" },
    "resource_id": { "type": "string", "format": "uuid" },
    "starts_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "enabled": { "type": "boolean" },
    "revoked_at": { "type": "string", "format": "date-time" },
    "expired_at": { "type": "string", "format": "date-time" },
    "created_by_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
