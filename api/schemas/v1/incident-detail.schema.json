{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://espial.ubnetdef.org/schemas/v1/incident-detail.schema.json",
  "title": "Incident API detail",
  "allOf": [
    { "$ref": "incident-summary.schema.json" },
    {
      "type": "object",
      "required": ["fingerprint"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  ]
}
