{
  "schema": "website-monitor-write",
  "data": {
    "display_name": "Status site",
    "enabled": true,
    "url": "https://status.example.invalid/health",
    "interval_seconds": 60,
    "timeout_ms": 5000,
    "warning_latency_ms": 1000,
    "certificate_warning_days": 30,
    "certificate_critical_days": 14,
    "certificate_escalation_days": 7,
    "allowed_statuses": [200],
    "content_match": "ready",
    "follow_redirects": false,
    "max_redirects": 0,
    "secret_headers": [
      { "name": "Authorization", "secret_reference": "status-auth" }
    ]
  }
}
