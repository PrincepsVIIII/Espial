.PHONY: check contracts dev down start stop restart format generate lint test

check:
	npm run check

contracts:
	npm run contracts

dev:
	npm run dev

down:
	npm run down

start:
	npm run start

stop:
	npm run stop

restart:
	npm run restart

format:
	npm run format

generate:
	npm run generate

lint:
	npm run lint

test:
	npm test
